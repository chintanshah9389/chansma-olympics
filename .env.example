# --- Local API server (npm run dev) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chansma
DATABASE_SSL=false
PORT=3001

# Cricket photos and payment screenshots. Local default is ./uploads.
# On Railway, add a volume mounted at /data. The server then uses /data/uploads.
# UPLOAD_DIR=/data/uploads

# Admin page (#/admin). Change these before sharing the site.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=change-me

# --- Optional: point Vite at live Railway (`npm run dev:live` only) ---
# Put this in .env.live, not .env.local. `.env.local` is loaded by every build
# and would send the local Admin login to the live site.
# VITE_API_URL=https://chansma-olympics-production.up.railway.app
