<mxfile host="app.diagrams.net" modified="2026-09-28T21:18:00.000Z" agent="Antigravity" version="24.0.0" type="device">
  <diagram id="cashfree-zero-failure-arch" name="Cashfree Zero-Failure Architecture">
    <mxGraphModel dx="1680" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1500" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TOP BANNER -->
        <mxCell id="hdr" value="CHANSMA OLYMPICS — ZERO-FAILURE CASHFREE PAYMENT ARCHITECTURE&#xa;Dual-Channel Verification · Atomic PostgreSQL State Machine · Zero-Trust Client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#020617;strokeWidth=2;fontColor=#ffffff;fontSize=17;fontStyle=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1560" height="60" as="geometry" />
        </mxCell>

        <!-- SWIMLANE 1: FRONTEND -->
        <mxCell id="lane_fe" value="1. USER &amp; FRONTEND (Browser / Vite)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;fontColor=#1e3a8a;fontSize=14;fontStyle=1;startSize=36;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="360" height="1340" as="geometry" />
        </mxCell>

        <!-- SWIMLANE 2: BACKEND -->
        <mxCell id="lane_be" value="2. OUR BACKEND (Node.js / Express)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2;fontColor=#78350f;fontSize=14;fontStyle=1;startSize=36;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="430" y="100" width="390" height="1340" as="geometry" />
        </mxCell>

        <!-- SWIMLANE 3: CASHFREE -->
        <mxCell id="lane_cf" value="3. CASHFREE GATEWAY &amp; BANK" style="swimlane;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#7e22ce;strokeWidth=2;fontColor=#581c87;fontSize=14;fontStyle=1;startSize=36;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="850" y="100" width="360" height="1340" as="geometry" />
        </mxCell>

        <!-- SWIMLANE 4: DATABASE -->
        <mxCell id="lane_db" value="4. POSTGRESQL (Source of Truth)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#15803d;strokeWidth=2;fontColor=#14532d;fontSize=14;fontStyle=1;startSize=36;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="1240" y="100" width="360" height="1340" as="geometry" />
        </mxCell>

        <!-- NODE 1: STEP 1 REVIEW -->
        <mxCell id="n1" value="1. Review &amp; Submit Form&#xa;User verifies filled data &amp; clicks:&#xa;&quot;Proceed to Payment (₹XXX)&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=2;fontColor=#0f172a;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="lane_fe">
          <mxGeometry x="30" y="60" width="300" height="60" as="geometry" />
        </mxCell>

        <!-- NODE 2: STEP 2 VALIDATION -->
        <mxCell id="n2" value="2. Validate &amp; Prepare Order&#xa;POST /api/payments/create-order&#xa;• Check mobile duplicates in sport&#xa;• Verify player age constraints" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;strokeWidth=2;fontColor=#0f172a;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="lane_be">
          <mxGeometry x="35" y="60" width="320" height="65" as="geometry" />
        </mxCell>

        <!-- NODE 3: PRE-SAVE IN DB -->
        <mxCell id="n3" value="3. Pre-Save Pending Order&#xa;INSERT INTO orders (&#xa;  order_id, status='PENDING',&#xa;  form_payload=[FORM_SNAPSHOT]&#xa;)&#xa;* Form data is safely saved in DB *" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="lane_db">
          <mxGeometry x="25" y="55" width="310" height="90" as="geometry" />
        </mxCell>

        <!-- NODE 4: BACKEND INIT CASHFREE -->
        <mxCell id="n4" value="4. Call Cashfree PGCreateOrder&#xa;Passes unique order_id, amount,&#xa;and customer mobile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;strokeWidth=2;fontColor=#0f172a;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="lane_be">
          <mxGeometry x="35" y="165" width="320" height="60" as="geometry" />
        </mxCell>

        <!-- NODE 5: CASHFREE SESSION -->
        <mxCell id="n5" value="5. Generate Payment Session&#xa;Returns payment_session_id&#xa;Order status = 'ACTIVE'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9333ea;strokeWidth=2;fontColor=#0f172a;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="lane_cf">
          <mxGeometry x="30" y="165" width="300" height="60" as="geometry" />
        </mxCell>

        <!-- NODE 6: FRONTEND MODAL -->
        <mxCell id="n6" value="6. Launch Checkout Modal&#xa;SDK: @cashfreepayments/cashfree-js&#xa;redirectTarget: '_modal'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=2;fontColor=#0f172a;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="lane_fe">
          <mxGeometry x="30" y="270" width="300" height="60" as="geometry" />
        </mxCell>

        <!-- NODE 7: USER PAYS -->
        <mxCell id="n7" value="7. User Authorizes Payment&#xa;UPI / QR / Cards / Netbanking&#xa;Bank debits money · Cashfree marks PAID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9333ea;strokeWidth=2;fontColor=#0f172a;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="lane_cf">
          <mxGeometry x="30" y="270" width="300" height="60" as="geometry" />
        </mxCell>

        <!-- DIVIDER BANNER -->
        <mxCell id="div_banner" value="★ ZERO-FAILURE GUARANTEE: DUAL-CHANNEL SYNCHRONIZATION ★&#xa;Whichever channel completes first locks PostgreSQL atomically. No money or registration is ever lost." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#475569;strokeWidth=2;fontColor=#0f172a;fontSize=12;fontStyle=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="475" width="1520" height="45" as="geometry" />
        </mxCell>

        <!-- CHANNEL A (WEBHOOK) -->
        <mxCell id="n8a" value="CHANNEL A: Server-to-Server Webhook&#xa;POST /api/payments/webhook&#xa;Payload: PAYMENT_SUCCESS_WEBHOOK&#xa;Headers: x-webhook-signature" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#7e22ce;strokeWidth=2;fontColor=#0f172a;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="lane_cf">
          <mxGeometry x="25" y="455" width="310" height="75" as="geometry" />
        </mxCell>

        <mxCell id="n9a" value="Verify Cryptographic Signature&#xa;cashfree.PGVerifyWebhookSignature(&#xa;  signature, rawBody, timestamp, secretKey&#xa;)&#xa;* 100% Tamper-Proof HMAC SHA-256 *" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;strokeWidth=2;fontColor=#0f172a;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="lane_be">
          <mxGeometry x="35" y="455" width="320" height="75" as="geometry" />
        </mxCell>

        <!-- CHANNEL B (DIRECT VERIFY) -->
        <mxCell id="n8b" value="CHANNEL B: Fast-Track Client Callback&#xa;Modal closes after payment&#xa;Calls POST /api/payments/verify { orderId }&#xa;Shows: 'Verifying payment with bank...'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontColor=#0f172a;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="lane_fe">
          <mxGeometry x="25" y="580" width="310" height="75" as="geometry" />
        </mxCell>

        <mxCell id="n9b" value="Direct Bank Status Query&#xa;Backend calls Cashfree REST API:&#xa;Cashfree.PGFetchOrder(order_id)&#xa;* Zero-Trust: Never trusts frontend claim! *" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;strokeWidth=2;fontColor=#0f172a;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="lane_be">
          <mxGeometry x="35" y="580" width="320" height="75" as="geometry" />
        </mxCell>

        <!-- ATOMIC FULFILLMENT -->
        <mxCell id="n10" value="Atomic Lock in PostgreSQL&#xa;SELECT * FROM orders WHERE order_id = $1 FOR UPDATE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;strokeWidth=2;fontColor=#0f172a;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="lane_be">
          <mxGeometry x="35" y="695" width="320" height="50" as="geometry" />
        </mxCell>

        <mxCell id="n11" value="Order already&#xa;SUCCESS?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b45309;strokeWidth=2;fontColor=#0f172a;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="lane_be">
          <mxGeometry x="110" y="780" width="170" height="80" as="geometry" />
        </mxCell>

        <mxCell id="n12" value="Idempotent No-Op&#xa;Return 200 OK immediately.&#xa;Prevents duplicate seat allocation!" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=1.5;fontColor=#0f172a;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="lane_be">
          <mxGeometry x="20" y="890" width="180" height="55" as="geometry" />
        </mxCell>

        <!-- DB ATOMIC COMMIT -->
        <mxCell id="n13" value="Atomic Commit (BEGIN...COMMIT)&#xa;1. UPDATE orders SET status='SUCCESS', cf_payment_id=$1&#xa;2. INSERT INTO registrations (id, fullName, mobile, sports...)&#xa;   Restored safely from pre-saved form_payload snapshot&#xa;3. recalculateSeatStatuses() to assign Confirmed/Waiting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;strokeWidth=2;fontColor=#0f172a;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="lane_db">
          <mxGeometry x="15" y="870" width="330" height="100" as="geometry" />
        </mxCell>

        <!-- WEBSOCKET & SUCCESS -->
        <mxCell id="n14" value="WebSocket Broadcast&#xa;broadcast('registrations-updated')&#xa;Admin screen &amp; public slot counters update live" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;strokeWidth=2;fontColor=#0f172a;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="lane_be">
          <mxGeometry x="35" y="1005" width="320" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n15" value="Step 5: Registration Confirmed!&#xa;• Displays Reference ID (CHN-XXXXXX)&#xa;• Displays Payment ID &amp; Receipt&#xa;• Confirmed / Waiting list badges" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="lane_fe">
          <mxGeometry x="25" y="995" width="310" height="80" as="geometry" />
        </mxCell>

        <!-- FAILURE FOOTER -->
        <mxCell id="fail_box" value="WHAT IF PAYMENT FAILS OR IS CANCELLED?&#xa;• Order marked status = 'FAILED' · NO registration inserted · NO seats blocked&#xa;• Form data remains intact on Step 4 Review so participant can easily retry&#xa;• If money debited erroneously by bank gateway, RBI auto-reversal refunds it in 24-48 hours" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;strokeWidth=2;fontColor=#7f1d1d;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="1270" width="1520" height="65" as="geometry" />
        </mxCell>

        <!-- CONNECTING EDGES WITH CLEAN STYLES -->
