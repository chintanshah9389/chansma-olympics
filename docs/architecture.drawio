        <!-- CHANNEL A WEBHOOK EDGES -->
        <mxCell id="e7" value="Bank Debits Money" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#7e22ce;strokeWidth=2;fontColor=#0f172a;fontSize=11;fontStyle=1;" edge="1" parent="1" source="n7" target="n8a">
